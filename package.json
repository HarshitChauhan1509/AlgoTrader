{
  "name": "stock-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Production-style personal algorithmic trading platform for the Indian market.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "tsc -p services/api/tsconfig.build.json",
    "dev": "concurrently \"pnpm --filter @stock-platform/api start:dev\" \"pnpm --filter @stock-platform/web dev\"",
    "lint": "eslint --config services/api/eslint.config.mjs \"services/api/{src,test}/**/*.ts\"",
    "test": "jest --config services/api/jest.config.ts",
    "test:cov": "jest --config services/api/jest.config.ts --coverage",
    "prisma:generate": "prisma generate --schema services/api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema services/api/prisma/schema.prisma --name init",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0"
  }
}